[{"t": 0.0, "vi": "Chào con!"}, {"t": 1.08, "vi": "Hôm nay mình học bài ba:"}, {"t": 3.89, "vi": "hỏi người đó là ai."}, {"t": 6.2, "vi": "Muốn hỏi bạn ấy là ai, con nói:"}, {"t": 10.92, "zh": "他是谁？"}, {"t": 15.78, "vi": "Trả lời bằng chữ là."}, {"t": 19.08, "vi": "Ví dụ:"}, {"t": 21.22, "zh": "他是我的朋友。"}, {"t": 27.36, "vi": "Học xong, con giới thiệu được bạn bè và cô giáo rồi!"}]