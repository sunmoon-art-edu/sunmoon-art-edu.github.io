{"d": 24.5, "c": [{"t": 0.1, "text": "Xin chào các bạn nhỏ! Cô là Cô Mặt Trời đây!", "zh": false, "moon": 0}, {"t": 4.33, "text": "Mỗi sáng, cô thức dậy thật sớm và chào các bạn bằng tiếng Trung:", "zh": false, "moon": 0}, {"t": 10.32, "text": "你好！", "zh": true, "moon": 0}, {"t": 13.44, "text": "Các bạn nói theo cô nhé!", "zh": false, "moon": 0}, {"t": 15.69, "text": "你好！", "zh": true, "moon": 0}, {"t": 19.17, "text": "Nào, mình bắt đầu thôi!", "zh": false, "moon": 0}, {"t": 21.62, "text": "一，二，三，走！", "zh": true, "moon": 0}]}